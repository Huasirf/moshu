// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.moshu.ide",
  // pnpm 的可选原生包（@lancedb/lancedb-win32-x64-msvc）无法被 asarUnpack 正确解包，
  // 开启 asar 会导致打包后找不到 .node、应用启动即崩；这里统一关闭 asar。
  "asar": false,
  "asarUnpack": [
    "node_modules/apache-arrow/**/*",
    "node_modules/better-sqlite3/**/*",
    "node_modules/@lancedb/lancedb-darwin-*/**/*",
    "node_modules/@lancedb/lancedb-linux-*/**/*",
    "node_modules/@lancedb/lancedb-win32-*/**/*"
  ],
  "productName": "墨枢",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron",
    "build",
    // pnpm 不会把 lancedb 的可选平台包提升到 node_modules/@lancedb，
    // 这里显式映射，否则打包后缺少 .node，应用启动即崩
    {
      "from": "node_modules/.pnpm/@lancedb+lancedb-win32-x64-msvc@0.27.2/node_modules/@lancedb/lancedb-win32-x64-msvc",
      "to": "node_modules/@lancedb/lancedb-win32-x64-msvc"
    }
  ],
  "mac": {
    "target": ["dmg"],
    // 必须带 ${arch}：arm64 与 x64 分两个 runner 构建，同名会在 Release 里互相覆盖
    "artifactName": "${productName}-Mac-${version}-${arch}-Installer.${ext}",
    "category": "public.app-category.productivity",
    // 无 Apple Developer 证书，跳过签名（CI 里同时设了 CSC_IDENTITY_AUTO_DISCOVERY=false）
    "identity": null
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "artifactName": "${productName}-${version}-setup.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "portable": {
    "artifactName": "${productName}-${version}-portable.${ext}"
  },
  "linux": {
    "target": ["AppImage"],
    "artifactName": "${productName}-Linux-${version}.${ext}",
    "category": "Office"
  }
}
